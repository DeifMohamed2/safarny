<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' && title && title !== 'Safarny' ? title + ' | Safarny' : 'Safarny' %></title>
    <meta
      name="description"
      content="Safarny helps you discover and book unforgettable trips with the best travel deals. Explore destinations, compare offers, and plan your next adventure with ease."
    />
    <meta property="og:title" content="Safarny" />
    <meta property="og:image" content="/opengraph.jpg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/css/app.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
      @theme {
        --font-sans: "Poppins", sans-serif;
        --font-arabic: "Cairo", sans-serif;
        --color-primary: #263859;
        --color-navy: #122445;
        --color-accent: #ef7722;
      }
    </style>
  </head>
  <body class="min-h-dvh bg-white overflow-x-hidden antialiased">
    <div id="toast-stack" class="toast-stack">
      <% if (typeof flash !== 'undefined' && flash) { %>
        <div class="toast" role="status">
          <div class="toast-body">
            <p class="font-semibold text-[#122445]"><%= flash.message %></p>
          </div>
          <button type="button" class="toast-close" data-toast-close aria-label="<%= t('shared.close', 'Close') %>">×</button>
        </div>
      <% } %>
    </div>
    <%- include('../partials/navbar') %>
    <% if (typeof isCompany !== 'undefined' && isCompany && !payoutReady && company && company.verification !== 'verified') { %>
      <div class="site-payout-banner" role="alert">
        <div class="site-payout-banner-inner">
          <strong><%= t('company.settings.payoutRequiredTitle', 'Add a payout method to verify your account') %></strong>
          <span><%= t('company.settings.payoutRequiredBody', 'Safarny cannot verify your company until you save how you want to get paid.') %></span>
          <a href="/company/settings#payout-details"><%= t('company.settings.payoutRequiredAction', 'Add payout method') %></a>
        </div>
      </div>
    <% } %>
    <main>
      <%- body %>
    </main>
    <%- include('../partials/footer') %>
    <%- include('../partials/dialogs') %>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="/js/app.js"></script>
    <%- typeof scripts !== 'undefined' ? scripts : '' %>
  </body>
</html>
