<div class="min-h-dvh w-full flex flex-col items-center justify-center p-4 relative overflow-hidden pt-32">
  <div class="relative z-10 w-full max-w-lg text-center space-y-8">
    <h1 class="text-4xl md:text-6xl font-bold text-[#122445]"><%= typeof heading !== 'undefined' ? heading : '404' %></h1>
    <h2 class="text-2xl md:text-3xl font-bold text-[#263859]">Lost in Space</h2>
    <p class="text-slate-500 max-w-md mx-auto">
      <%= typeof message !== 'undefined' ? message : "The page you're looking for has drifted away into the void. Let's get you back to safety." %>
    </p>
    <a href="/" class="inline-flex items-center rounded-full bg-[#263859] hover:bg-[#2a4d7f] text-white px-8 py-3">Return Home</a>
  </div>
</div>
