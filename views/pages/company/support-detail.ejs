<%
  const statusKey = function(status) {
    return 'company.support.status' + status.charAt(0).toUpperCase() + status.slice(1);
  };
%>
<%- include('../../partials/company-shell-start', { companyActive: 'support' }) %>
  <div class="company-support-page company-support-detail-page" data-company-support-detail>
    <header class="company-support-detail-top" data-scroll-reveal>
      <div class="company-support-detail-top-main">
        <a href="/company/support" class="company-support-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <%= t('company.support.backToTickets', 'Back to tickets') %>
        </a>
        <div class="company-support-detail-title">
          <div class="company-support-detail-badges">
            <span class="company-support-no"><%= ticket.ticketNo %></span>
            <span class="company-ticket-status company-ticket-status--<%= ticket.status %>"><%= t(statusKey(ticket.status), ticket.status) %></span>
            <span class="company-ticket-priority company-ticket-priority--<%= ticket.priority %>"><%= statusLabel(ticket.priority) %></span>
          </div>
          <h1 class="company-title"><%= ticket.subject %></h1>
          <p class="company-subtitle"><%= ticket.category %> · <%= t('company.support.created', 'Created') %> <%= ticket.createdAt %></p>
        </div>
      </div>
    </header>

    <div class="company-support-admin-bar" data-scroll-reveal>
      <div class="company-support-admin-card">
        <img src="<%= supportAvatar %>" alt="" class="company-support-admin-avatar" />
        <div>
          <strong><%= supportName %></strong>
          <span><%= t('company.support.assignedTeam', 'Platform support team') %></span>
        </div>
      </div>
      <span class="company-support-meta-chip">
        <span><%= t('company.support.category', 'Category') %></span>
        <strong><%= ticket.category %></strong>
      </span>
      <span class="company-support-meta-chip">
        <span><%= t('company.support.updated', 'Updated') %></span>
        <strong><%= ticket.updatedAt %></strong>
      </span>
    </div>

    <section class="company-support-chat-panel company-panel" data-scroll-reveal>
      <div class="company-support-messages" data-support-messages>
        <% threadItems.forEach(function(item) { %>
          <% if (item.type === 'date') { %>
            <p class="company-support-date"><%= item.date %></p>
          <% } else { %>
            <article class="company-support-bubble <%= item.from === 'company' ? 'is-self' : '' %>">
              <% if (item.from === 'admin') { %>
                <div class="company-support-bubble-admin">
                  <img src="<%= supportAvatar %>" alt="" />
                  <div>
                    <header>
                      <strong><%= item.author %></strong>
                      <time><%= item.time %></time>
                    </header>
                    <% if (item.text) { %><p><%= item.text %></p><% } %>
                    <%- include('../../partials/support-message-attachments', { attachments: item.attachments }) %>
                  </div>
                </div>
              <% } else { %>
                <header>
                  <strong><%= item.author %></strong>
                  <time><%= item.time %></time>
                </header>
                <% if (item.text) { %><p><%= item.text %></p><% } %>
                <%- include('../../partials/support-message-attachments', { attachments: item.attachments }) %>
              <% } %>
            </article>
          <% } %>
        <% }) %>
      </div>

      <% if (ticket.status !== 'closed') { %>
        <form class="company-support-compose" method="post" action="/company/support/<%= ticket.id %>/reply" data-company-support-reply enctype="multipart/form-data">
          <textarea name="text" rows="2" class="company-input" placeholder="<%= t('company.support.replyPlaceholder', 'Write your reply to Safarny support...') %>"></textarea>
          <div class="company-support-compose-footer">
            <div class="company-support-compose-tools">
              <label class="company-support-attach-btn" title="<%= t('company.support.attachFiles', 'Attach files') %>">
                <input type="file" name="attachments" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip" hidden data-support-file-input />
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span><%= t('company.support.attach', 'Attach') %></span>
              </label>
              <div class="support-attach-preview" data-support-file-preview hidden></div>
            </div>
            <button type="submit" class="cp-btn cp-btn--primary"><%= t('company.support.sendReply', 'Send reply') %></button>
          </div>
        </form>
        <p class="company-support-compose-hint"><%= t('company.support.attachHint', 'Images, PDF, Word, Excel, ZIP — up to 5 files, 10 MB each') %></p>
      <% } else { %>
        <p class="company-support-closed"><%= t('company.support.closedNotice', 'This ticket is closed. Open a new ticket if you need further assistance.') %></p>
      <% } %>
    </section>
  </div>
<%- include('../../partials/company-shell-end') %>
