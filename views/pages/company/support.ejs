<%
  const statusOptions = [
    { id: 'all', label: t('company.tripStatus.all', 'All') },
    { id: 'open', label: t('company.support.statusOpen', 'Open') },
    { id: 'pending', label: t('company.support.statusPending', 'Pending') },
    { id: 'resolved', label: t('company.support.statusResolved', 'Resolved') },
    { id: 'closed', label: t('company.support.statusClosed', 'Closed') },
  ];
  const filterQuery = function(overrides) {
    const next = Object.assign({}, filters, overrides || {});
    return Object.keys(next)
      .filter(function(key) { return next[key] !== '' && next[key] !== null && next[key] !== undefined; })
      .map(function(key) { return encodeURIComponent(key) + '=' + encodeURIComponent(next[key]); })
      .join('&');
  };
  const pageNumbers = [];
  const currentPage = pagination.page;
  const totalPages = pagination.totalPages;
  for (let page = 1; page <= totalPages; page += 1) {
    if (page === 1 || page === totalPages || Math.abs(page - currentPage) <= 1) pageNumbers.push(page);
  }
  const statusKey = function(status) {
    return 'company.support.status' + status.charAt(0).toUpperCase() + status.slice(1);
  };
%>
<%- include('../../partials/company-shell-start', { companyActive: 'support' }) %>
  <div class="company-support-page" data-company-support-list>
    <header class="company-header company-header--compact" data-scroll-reveal>
      <div>
        <h1 class="company-title"><%= t('company.support.title', 'Support Tickets') %></h1>
        <p class="company-subtitle"><%= t('company.support.subtitle', 'Contact Safarny support for payouts, listings, and platform help.') %></p>
      </div>
      <div class="company-header-actions">
        <% if (meta.unread) { %>
          <span class="company-header-pill company-header-pill--alert"><%= meta.unread %> <%= t('company.support.unread', 'unread') %></span>
        <% } %>
        <a href="/company/support/new" class="cp-btn cp-btn--primary cp-btn--sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <%= t('company.support.newTicket', 'New ticket') %>
        </a>
      </div>
    </header>

    <div class="company-booking-tabs company-booking-tabs--compact" data-scroll-reveal>
      <% statusOptions.forEach(function(option) { %>
        <a href="/company/support?<%= filterQuery({ status: option.id, page: 1 }) %>" class="company-booking-tab <%= filters.status === option.id ? 'is-active' : '' %>">
          <span><%= option.label %></span>
          <strong><%= meta.statusCounts[option.id] || 0 %></strong>
        </a>
      <% }) %>
    </div>

    <section class="company-filters company-booking-filters company-booking-filters--compact" data-company-support-filters data-scroll-reveal>
      <form class="company-filters-form" method="get" action="/company/support" data-company-support-form>
        <input type="hidden" name="status" value="<%= filters.status %>" />
        <input type="hidden" name="page" value="1" data-support-page-input />

        <div class="company-booking-filter-toolbar">
          <label class="company-search-field company-search-field--compact">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.7"/>
              <path d="M16.5 16.5 20 20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
            <input type="search" name="q" value="<%= filters.q %>" placeholder="<%= t('company.support.search', 'Search tickets') %>" class="company-input company-input--search" data-support-search />
          </label>

          <label class="company-filter-field company-filter-field--compact">
            <span><%= t('company.support.category', 'Category') %></span>
            <select name="category" class="company-input company-input--sm" data-support-auto-submit>
              <option value="all" <%= filters.category === 'all' ? 'selected' : '' %>><%= t('company.tripStatus.all', 'All') %></option>
              <% meta.categories.forEach(function(cat) { %>
                <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
              <% }) %>
            </select>
          </label>

          <label class="company-filter-field company-filter-field--compact">
            <span><%= t('company.support.priority', 'Priority') %></span>
            <select name="priority" class="company-input company-input--sm" data-support-auto-submit>
              <option value="all" <%= filters.priority === 'all' ? 'selected' : '' %>><%= t('company.tripStatus.all', 'All') %></option>
              <option value="urgent" <%= filters.priority === 'urgent' ? 'selected' : '' %>><%= t('company.support.priorityUrgent', 'Urgent') %></option>
              <option value="high" <%= filters.priority === 'high' ? 'selected' : '' %>><%= t('company.support.priorityHigh', 'High') %></option>
              <option value="normal" <%= filters.priority === 'normal' ? 'selected' : '' %>><%= t('company.support.priorityNormal', 'Normal') %></option>
              <option value="low" <%= filters.priority === 'low' ? 'selected' : '' %>><%= t('company.support.priorityLow', 'Low') %></option>
            </select>
          </label>

          <label class="company-filter-field company-filter-field--compact">
            <span><%= t('company.bookings.filterSort', 'Sort by') %></span>
            <select name="sort" class="company-input company-input--sm" data-support-auto-submit>
              <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>><%= t('company.support.sortNewest', 'Newest') %></option>
              <option value="updated" <%= filters.sort === 'updated' ? 'selected' : '' %>><%= t('company.support.sortUpdated', 'Recently updated') %></option>
              <option value="priority" <%= filters.sort === 'priority' ? 'selected' : '' %>><%= t('company.support.sortPriority', 'Priority') %></option>
              <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>><%= t('company.support.sortOldest', 'Oldest') %></option>
            </select>
          </label>

          <div class="company-filters-actions company-filters-actions--inline">
            <button type="submit" class="cp-btn cp-btn--primary cp-btn--sm"><%= t('filter.search', 'Search') %></button>
            <% if (hasActiveFilters) { %>
              <a href="/company/support" class="cp-btn cp-btn--ghost cp-btn--sm"><%= t('company.trips.clearFilters', 'Clear') %></a>
            <% } %>
          </div>
        </div>
      </form>
    </section>

    <% if (!items.length) { %>
      <div class="company-empty-state" data-scroll-reveal>
        <div class="company-empty-state-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none">
            <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2><%= t('company.support.emptyTitle', 'No tickets found') %></h2>
        <p><%= t('company.support.emptyHint', 'Create a ticket to reach the Safarny support team.') %></p>
        <div class="company-empty-state-actions">
          <a href="/company/support/new" class="cp-btn cp-btn--primary"><%= t('company.support.newTicket', 'New ticket') %></a>
        </div>
      </div>
    <% } else { %>
      <div class="company-table-wrap company-panel company-support-table" data-scroll-reveal>
        <div class="company-table-toolbar">
          <p class="company-results-copy">
            <%= t('company.bookings.showingRange', 'Showing') %>
            <strong><%= pagination.start %>–<%= pagination.end %></strong>
            <%= t('company.bookings.of', 'of') %>
            <strong><%= pagination.total %></strong>
          </p>
        </div>
        <table class="company-table">
          <thead>
            <tr>
              <th><%= t('company.support.ticketNo', 'Ticket') %></th>
              <th><%= t('company.support.subject', 'Subject') %></th>
              <th><%= t('company.support.category', 'Category') %></th>
              <th><%= t('company.support.priority', 'Priority') %></th>
              <th><%= t('company.bookings.status', 'Status') %></th>
              <th><%= t('company.support.updated', 'Updated') %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(function(ticket) { %>
              <tr class="company-support-row <%= ticket.unread ? 'has-unread' : '' %>">
                <td>
                  <a href="/company/support/<%= ticket.id %>" class="company-support-ticket-link">
                    <%= ticket.ticketNo %>
                    <% if (ticket.unread) { %><span class="company-support-dot" aria-label="<%= t('company.support.unread', 'unread') %>"></span><% } %>
                  </a>
                </td>
                <td><a href="/company/support/<%= ticket.id %>" class="company-support-subject-link"><%= ticket.subject %></a></td>
                <td><span class="company-ticket-category"><%= ticket.category %></span></td>
                <td><span class="company-ticket-priority company-ticket-priority--<%= ticket.priority %>"><%= ticket.priority %></span></td>
                <td><span class="company-ticket-status company-ticket-status--<%= ticket.status %>"><%= t(statusKey(ticket.status), ticket.status) %></span></td>
                <td><%= ticket.updatedAt %></td>
                <td><a href="/company/support/<%= ticket.id %>" class="cp-btn cp-btn--ghost cp-btn--sm"><%= t('shared.viewDetails', 'View') %></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <nav class="company-pagination company-pagination--footer" aria-label="<%= t('company.support.pagination', 'Tickets pagination') %>">
          <a href="/company/support?<%= filterQuery({ page: pagination.page - 1 }) %>" class="company-page-btn <%= pagination.hasPrev ? '' : 'is-disabled' %>" <%= pagination.hasPrev ? '' : 'aria-disabled="true" tabindex="-1"' %>>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <%= t('company.bookings.prev', 'Previous') %>
          </a>
          <div class="company-page-list">
            <% let lastPage = 0; %>
            <% pageNumbers.forEach(function(page) { %>
              <% if (lastPage && page - lastPage > 1) { %><span class="company-page-ellipsis">…</span><% } %>
              <a href="/company/support?<%= filterQuery({ page: page }) %>" class="company-page-btn <%= page === pagination.page ? 'is-active' : '' %>"><%= page %></a>
              <% lastPage = page; %>
            <% }) %>
          </div>
          <a href="/company/support?<%= filterQuery({ page: pagination.page + 1 }) %>" class="company-page-btn <%= pagination.hasNext ? '' : 'is-disabled' %>" <%= pagination.hasNext ? '' : 'aria-disabled="true" tabindex="-1"' %>>
            <%= t('company.bookings.next', 'Next') %>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </nav>
      </div>
    <% } %>
  </div>
<%- include('../../partials/company-shell-end') %>
