<%- include('../../partials/company-shell-start', { companyActive: 'support' }) %>
  <div class="company-support-page company-support-form-page" data-scroll-reveal>
    <header class="company-header company-header--compact">
      <div>
        <a href="/company/support" class="company-support-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <%= t('company.support.backToTickets', 'Back to tickets') %>
        </a>
        <h1 class="company-title"><%= t('company.support.newTicket', 'New ticket') %></h1>
        <p class="company-subtitle"><%= t('company.support.newTicketDesc', 'Describe your issue and our platform team will get back to you.') %></p>
      </div>
    </header>

    <section class="company-panel company-support-new-panel">
      <form class="company-form" method="post" action="/company/support">
        <div class="company-form-grid company-form-grid--support">
          <label class="company-field company-field--full">
            <span><%= t('company.support.subject', 'Subject') %></span>
            <input type="text" name="subject" required maxlength="120" class="company-input" placeholder="<%= t('company.support.subjectPlaceholder', 'Brief summary of your issue') %>" />
          </label>

          <label class="company-field">
            <span><%= t('company.support.category', 'Category') %></span>
            <select name="category" class="company-input" required>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% }) %>
            </select>
          </label>

          <label class="company-field">
            <span><%= t('company.support.priority', 'Priority') %></span>
            <select name="priority" class="company-input">
              <option value="normal"><%= t('company.support.priorityNormal', 'Normal') %></option>
              <option value="low"><%= t('company.support.priorityLow', 'Low') %></option>
              <option value="high"><%= t('company.support.priorityHigh', 'High') %></option>
              <option value="urgent"><%= t('company.support.priorityUrgent', 'Urgent') %></option>
            </select>
          </label>

          <label class="company-field company-field--full">
            <span><%= t('company.support.message', 'Message') %></span>
            <textarea name="message" required rows="6" class="company-input" placeholder="<%= t('company.support.messagePlaceholder', 'Provide details so we can help you faster') %>"></textarea>
          </label>
        </div>

        <div class="company-form-actions">
          <a href="/company/support" class="cp-btn cp-btn--ghost"><%= t('shared.cancel', 'Cancel') %></a>
          <button type="submit" class="cp-btn cp-btn--primary"><%= t('company.support.submitTicket', 'Submit ticket') %></button>
        </div>
      </form>
    </section>
  </div>
<%- include('../../partials/company-shell-end') %>
