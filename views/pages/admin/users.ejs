<%- include('../../partials/admin-shell-start') %>
<%
  function filterQuery(overrides) {
    const q = Object.assign({}, filters, overrides || {});
    return Object.keys(q).filter(function(k) { return q[k] && q[k] !== 'all'; }).map(function(k) { return encodeURIComponent(k) + '=' + encodeURIComponent(q[k]); }).join('&');
  }
%>
<div class="admin-header admin-header--compact">
  <div>
    <h2 class="admin-title"><%= t('admin.users.title', 'Users') %></h2>
    <p class="admin-subtitle"><%= t('admin.users.subtitle', 'Manage travelers, companies, and admins') %></p>
  </div>
  <a href="/admin/users/new" class="adm-btn adm-btn--primary"><%= t('admin.users.create', 'Create admin') %></a>
</div>
<form method="get" class="admin-filters" data-admin-filters>
  <input type="search" name="q" value="<%= filters.q || '' %>" placeholder="<%= t('admin.search', 'Search...') %>" class="admin-input" />
  <select name="role" class="admin-input">
    <option value="all"><%= t('admin.filter.allRoles', 'All roles') %></option>
    <option value="traveler" <%= filters.role === 'traveler' ? 'selected' : '' %>><%= t('admin.role.traveler', 'Traveler') %></option>
    <option value="company" <%= filters.role === 'company' ? 'selected' : '' %>><%= t('admin.role.company', 'Company') %></option>
    <option value="admin" <%= filters.role === 'admin' ? 'selected' : '' %>><%= t('admin.role.admin', 'Admin') %></option>
  </select>
  <select name="status" class="admin-input">
    <option value="all"><%= t('admin.filter.allStatus', 'All status') %></option>
    <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>><%= t('admin.status.active', 'Active') %></option>
    <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>><%= t('admin.status.suspended', 'Suspended') %></option>
  </select>
  <button type="submit" class="adm-btn adm-btn--primary adm-btn--sm"><%= t('admin.filter.apply', 'Apply') %></button>
</form>
<% if (!users.length) { %>
  <%- include('../../partials/admin-empty') %>
<% } else { %>
  <div class="admin-table-wrap admin-panel">
    <table class="admin-table">
      <thead><tr><th><%= t('admin.table.name', 'Name') %></th><th><%= t('admin.table.email', 'Email') %></th><th><%= t('admin.table.role', 'Role') %></th><th><%= t('admin.table.status', 'Status') %></th><th></th></tr></thead>
      <tbody>
        <% users.forEach(function(u) { %>
          <tr>
            <td><%= u.userName %></td>
            <td><%= u.email %></td>
            <td><span class="admin-status admin-status--<%= u.role %>"><%= roleLabel(u.role) %></span></td>
            <td><span class="admin-status admin-status--<%= u.status || 'active' %>"><%= statusLabel(u.status || 'active') %></span></td>
            <td><a href="/admin/users/<%= u.id %>" class="adm-btn adm-btn--sm adm-btn--ghost"><%= t('admin.actions.view', 'View') %></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../../partials/admin-pagination', { filterQuery: filterQuery }) %>
<% } %>
<%- include('../../partials/admin-shell-end') %>
