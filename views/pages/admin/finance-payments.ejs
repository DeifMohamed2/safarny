<%- include('../../partials/admin-shell-start') %>
<%
  function filterQuery(overrides) {
    const q = Object.assign({}, filters, overrides || {});
    return Object.keys(q).filter(function(k) { return q[k] && q[k] !== 'all'; }).map(function(k) { return encodeURIComponent(k) + '=' + encodeURIComponent(q[k]); }).join('&');
  }
  const exportQs = filterQuery();
%>
<div class="admin-header admin-header--compact">
  <div>
    <a href="/admin/finance" class="admin-back"><%= t('admin.finance.title', 'Finance') %></a>
    <h2 class="admin-title"><%= t('admin.finance.payments', 'Payments') %></h2>
    <p class="admin-subtitle"><%= t('admin.finance.paymentsSubtitle', 'Review transfer proofs and settlement status') %></p>
  </div>
  <a href="/admin/finance/payments/export.csv<%= exportQs ? '?' + exportQs : '' %>" class="adm-btn adm-btn--secondary adm-btn--sm"><%= t('admin.finance.exportCsv', 'Export CSV') %></a>
</div>

<form method="get" class="admin-filters admin-filters--finance" data-admin-filters>
  <div class="admin-filters-row">
    <input
      type="search"
      name="q"
      value="<%= filters.q || '' %>"
      placeholder="<%= t('admin.finance.searchPlaceholder', 'Search payment ID, booking code, SAF code, customer, phone, transfer ref, trip...') %>"
      class="admin-input admin-input--search"
      autocomplete="off"
    />
    <select name="status" class="admin-input">
      <option value="all"><%= t('admin.filter.allStatus', 'All status') %></option>
      <% ['submitted','verified','rejected'].forEach(function(s) { %>
        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
    <select name="method" class="admin-input">
      <option value="all"><%= t('admin.finance.allMethods', 'All methods') %></option>
      <% [
        { id: 'instapay', label: t('checkout.methods.instapay', 'InstaPay') },
        { id: 'mobile_wallet', label: t('checkout.methods.mobileWallet', 'Mobile wallet') },
      ].forEach(function(m) { %>
        <option value="<%= m.id %>" <%= filters.method === m.id ? 'selected' : '' %>><%= m.label %></option>
      <% }) %>
    </select>
  </div>
  <div class="admin-filters-row admin-filters-row--secondary">
    <label class="admin-filter-date">
      <span><%= t('admin.finance.dateFrom', 'From') %></span>
      <input type="date" name="dateFrom" value="<%= filters.dateFrom || '' %>" class="admin-input admin-input--sm" />
    </label>
    <label class="admin-filter-date">
      <span><%= t('admin.finance.dateTo', 'To') %></span>
      <input type="date" name="dateTo" value="<%= filters.dateTo || '' %>" class="admin-input admin-input--sm" />
    </label>
    <button type="submit" class="adm-btn adm-btn--primary adm-btn--sm"><%= t('admin.filter.apply', 'Apply') %></button>
    <% if (hasActiveFilters) { %>
      <a href="/admin/finance/payments" class="adm-btn adm-btn--ghost adm-btn--sm"><%= t('admin.filter.clear', 'Clear') %></a>
    <% } %>
  </div>
  <p class="admin-filters-hint"><%= t('admin.finance.searchHint', 'Connected search across payment, booking, customer, sender wallet, and transfer reference.') %></p>
</form>

<% if (typeof meta !== 'undefined' && meta.total !== undefined) { %>
  <p class="admin-results-meta"><%= meta.total %> <%= t('admin.finance.results', 'payments') %></p>
<% } %>

<% if (!payments.length) { %>
  <%- include('../../partials/admin-empty') %>
<% } else { %>
  <div class="admin-table-wrap admin-panel">
    <table class="admin-table admin-table--finance">
      <thead>
        <tr>
          <th><%= t('admin.finance.paymentId', 'Payment') %></th>
          <th><%= t('admin.table.customer', 'Customer') %></th>
          <th><%= t('admin.finance.method', 'Method') %></th>
          <th><%= t('admin.table.amount', 'Amount') %></th>
          <th><%= t('admin.table.status', 'Status') %></th>
          <th><%= t('admin.finance.proof', 'Proof') %></th>
          <th><%= t('admin.table.updated', 'Submitted') %></th>
        </tr>
      </thead>
      <tbody>
        <% payments.forEach(function(payment) { %>
          <tr data-href="/admin/finance/payments/<%= encodeURIComponent(payment.id) %>" class="admin-support-row">
            <td>
              <a href="/admin/finance/payments/<%= encodeURIComponent(payment.id) %>" class="admin-link"><%= payment.id %></a>
              <span class="admin-muted-sm block">
                <a href="/admin/bookings/<%= payment.bookingId %>" class="admin-link admin-link--sm"><%= payment.bookingCode %></a>
                <% if (payment.referenceCode) { %> · <%= payment.referenceCode %><% } %>
              </span>
            </td>
            <td>
              <strong><%= payment.customerName %></strong>
              <span class="admin-muted-sm block"><%= payment.tripName %></span>
              <% if (payment.customerEmail || payment.customerPhone) { %>
                <span class="admin-muted-sm block">
                  <%= payment.customerEmail || '' %><% if (payment.customerEmail && payment.customerPhone) { %> · <% } %><%= payment.customerPhone || '' %>
                </span>
              <% } %>
              <% if (payment.transferRef) { %>
                <span class="admin-muted-sm block"><%= t('admin.finance.transferRef', 'Transfer reference') %>: <%= payment.transferRef %></span>
              <% } %>
            </td>
            <td><%= payment.methodLabel %></td>
            <td><%= formatPrice(payment.amount) %> <%= payment.currency %></td>
            <td><span class="admin-status admin-status--<%= payment.status %>"><%= statusLabel(payment.status) %></span></td>
            <td>
              <% if (payment.proof && payment.proof.viewUrl) { %>
                <div class="admin-finance-proof-actions">
                  <a href="<%= payment.proof.viewUrl %>" target="_blank" rel="noopener" class="admin-link admin-link--sm"><%= t('admin.finance.viewProof', 'View') %></a>
                  <a href="<%= payment.proof.downloadUrl %>" download="<%= payment.proof.downloadName %>" class="admin-link admin-link--sm"><%= t('admin.finance.downloadProof', 'Download') %></a>
                </div>
              <% } else { %>
                <span class="admin-muted-sm">—</span>
              <% } %>
            </td>
            <td class="admin-muted-sm"><%= payment.submittedAt %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../../partials/admin-pagination', { filterQuery: filterQuery }) %>
<% } %>
<%- include('../../partials/admin-shell-end') %>
