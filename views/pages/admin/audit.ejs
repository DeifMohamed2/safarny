<%- include('../../partials/admin-shell-start') %>
<%
  function filterQuery(overrides) {
    const q = Object.assign({}, filters, overrides || {});
    return Object.keys(q).filter(function(k) { return q[k] && q[k] !== 'all'; }).map(function(k) { return encodeURIComponent(k) + '=' + encodeURIComponent(q[k]); }).join('&');
  }
%>
<div class="admin-header admin-header--compact">
  <div>
    <h2 class="admin-title"><%= t('admin.audit.title', 'Audit log') %></h2>
    <p class="admin-subtitle"><%= t('admin.audit.subtitle', 'Track all admin actions on the platform') %></p>
  </div>
</div>
<form method="get" class="admin-filters" data-admin-filters>
  <input type="search" name="q" value="<%= filters.q || '' %>" placeholder="<%= t('admin.search', 'Search...') %>" class="admin-input" />
  <select name="entity" class="admin-input">
    <option value="all"><%= t('admin.filter.allEntities', 'All entities') %></option>
    <% ['company','trip','booking','user','ticket','review','platform'].forEach(function(e) { %>
      <option value="<%= e %>" <%= filters.entity === e ? 'selected' : '' %>><%= e %></option>
    <% }) %>
  </select>
  <button type="submit" class="adm-btn adm-btn--primary adm-btn--sm"><%= t('admin.filter.apply', 'Apply') %></button>
</form>
<% if (!entries.length) { %>
  <%- include('../../partials/admin-empty') %>
<% } else { %>
  <div class="admin-table-wrap admin-panel">
    <table class="admin-table">
      <thead><tr><th><%= t('admin.table.time', 'Time') %></th><th><%= t('admin.table.actor', 'Actor') %></th><th><%= t('admin.table.action', 'Action') %></th><th><%= t('admin.table.summary', 'Summary') %></th></tr></thead>
      <tbody>
        <% entries.forEach(function(entry) { %>
          <tr>
            <td><%= new Date(entry.at).toLocaleString() %></td>
            <td><%= entry.actorName %></td>
            <td><code class="admin-code"><%= entry.action %></code></td>
            <td><%= entry.summary %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../../partials/admin-pagination', { filterQuery: filterQuery }) %>
<% } %>
<%- include('../../partials/admin-shell-end') %>
