<%- include('../../partials/admin-shell-start') %>
<div class="admin-header admin-header--compact adm-people-header">
  <div>
    <h2 class="admin-title"><%= t('admin.admins.title', 'Admins') %></h2>
    <p class="admin-subtitle"><%= t('admin.admins.subtitle', 'Manage platform administrators and access') %></p>
  </div>
  <div class="admin-header-actions">
    <a href="/admin/travelers" class="adm-btn adm-btn--secondary"><%= t('admin.travelers.title', 'Travelers') %></a>
    <a href="/admin/admins/new" class="adm-btn adm-btn--primary">+ <%= t('admin.admins.create', 'Create admin') %></a>
  </div>
</div>

<div class="adm-people-kpis adm-people-kpis--compact">
  <article class="adm-people-kpi"><p class="adm-people-kpi-label"><%= t('admin.admins.total', 'Total admins') %></p><p class="adm-people-kpi-value"><%= stats.total %></p></article>
  <article class="adm-people-kpi"><p class="adm-people-kpi-label"><%= t('admin.status.active', 'Active') %></p><p class="adm-people-kpi-value"><%= stats.active %></p></article>
</div>

<form method="get" class="admin-filters adm-people-filters" data-admin-filters>
  <input type="search" name="q" value="<%= filters.q || '' %>" placeholder="<%= t('admin.admins.searchPlaceholder', 'Search admins...') %>" class="admin-input" />
  <select name="status" class="admin-input">
    <option value="all"><%= t('admin.filter.allStatus', 'All status') %></option>
    <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>><%= t('admin.status.active', 'Active') %></option>
    <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>><%= t('admin.status.suspended', 'Suspended') %></option>
  </select>
  <button type="submit" class="adm-btn adm-btn--primary adm-btn--sm"><%= t('admin.filter.apply', 'Apply') %></button>
</form>

<% if (!admins.length) { %>
  <%- include('../../partials/admin-empty', { actionHref: '/admin/admins/new', actionLabel: t('admin.admins.create', 'Create admin') }) %>
<% } else { %>
  <div class="admin-table-wrap admin-panel">
    <table class="admin-table admin-table--people">
      <thead>
        <tr>
          <th><%= t('admin.admins.admin', 'Admin') %></th>
          <th><%= t('admin.table.email', 'Email') %></th>
          <th><%= t('admin.table.phone', 'Phone') %></th>
          <th><%= t('admin.table.joined', 'Joined') %></th>
          <th><%= t('admin.admins.lastLogin', 'Last login') %></th>
          <th><%= t('admin.table.status', 'Status') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% admins.forEach(function(admin) { %>
          <tr class="adm-people-row" data-href="/admin/admins/<%= admin.id %>">
            <td>
              <div class="adm-people-cell-user">
                <img src="<%= admin.avatar || '/user.png' %>" alt="" class="adm-people-avatar adm-people-avatar--admin" width="40" height="40" />
                <div>
                  <a href="/admin/admins/<%= admin.id %>" class="adm-people-name"><%= admin.userName %></a>
                  <p class="adm-people-meta"><span class="admin-status admin-status--admin">admin</span></p>
                </div>
              </div>
            </td>
            <td><%= admin.email %></td>
            <td><%= admin.phone || '—' %></td>
            <td class="admin-muted-sm"><%= admin.createdAt %></td>
            <td class="admin-muted-sm"><%= admin.lastLoginAt || '—' %></td>
            <td><span class="admin-status admin-status--<%= admin.status || 'active' %>"><%= admin.status || 'active' %></span></td>
            <td>
              <div class="adm-people-actions">
                <a href="/admin/admins/<%= admin.id %>" class="adm-btn adm-btn--sm adm-btn--ghost"><%= t('admin.actions.view', 'View') %></a>
                <a href="/admin/admins/<%= admin.id %>/edit" class="adm-btn adm-btn--sm adm-btn--secondary"><%= t('admin.actions.edit', 'Edit') %></a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../../partials/admin-pagination', { filterQuery: filterQuery }) %>
<% } %>
<%- include('../../partials/admin-shell-end') %>
