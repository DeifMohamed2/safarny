<%- include('../../partials/admin-shell-start') %>
<%
  function filterQuery(overrides) {
    const q = Object.assign({}, filters, overrides || {});
    return Object.keys(q).filter(function(k) { return q[k] && q[k] !== 'all'; }).map(function(k) { return encodeURIComponent(k) + '=' + encodeURIComponent(q[k]); }).join('&');
  }
%>
<form method="get" class="admin-filters" data-admin-filters>
  <input type="search" name="q" value="<%= filters.q || '' %>" placeholder="<%= t('admin.search', 'Search...') %>" class="admin-input" />
  <select name="companyId" class="admin-input">
    <option value="all"><%= t('admin.filter.allCompanies', 'All companies') %></option>
    <% (typeof companies !== 'undefined' ? companies : []).forEach(function(c) { %>
      <option value="<%= c.id %>" <%= String(filters.companyId) === String(c.id) ? 'selected' : '' %>><%= c.title %></option>
    <% }) %>
  </select>
  <select name="status" class="admin-input">
    <option value="all"><%= t('admin.filter.allStatus', 'All status') %></option>
    <% ['pending','confirmed','cancelled','refunded'].forEach(function(s) { %>
      <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= t('admin.status.' + s, s) %></option>
    <% }) %>
  </select>
  <select name="paymentStatus" class="admin-input">
    <option value="all"><%= t('admin.filter.allPayment', 'All payment') %></option>
    <% ['unpaid','submitted','verified','rejected'].forEach(function(s) { %>
      <option value="<%= s %>" <%= filters.paymentStatus === s ? 'selected' : '' %>><%= t('company.paymentStatus.' + s, s) %></option>
    <% }) %>
  </select>
  <select name="sort" class="admin-input">
    <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>><%= t('admin.sort.newest', 'Newest') %></option>
    <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>><%= t('company.bookings.sortOldest', 'Oldest') %></option>
    <option value="amount-desc" <%= filters.sort === 'amount-desc' ? 'selected' : '' %>><%= t('admin.sort.amountHigh', 'Highest amount') %></option>
    <option value="trip-soon" <%= filters.sort === 'trip-soon' ? 'selected' : '' %>><%= t('company.bookings.sortTripSoon', 'Trip soonest') %></option>
  </select>
  <button type="submit" class="adm-btn adm-btn--primary adm-btn--sm"><%= t('admin.filter.apply', 'Apply') %></button>
  <% if (hasActiveFilters) { %>
    <a href="/admin/bookings" class="adm-btn adm-btn--ghost adm-btn--sm"><%= t('admin.filter.clear', 'Clear') %></a>
  <% } %>
  <span class="admin-filters-hint"><%= formatPrice(revenue) %> <%= t('shared.egp', 'EGP') %> <%= t('admin.bookings.revenue', 'revenue') %></span>
</form>
<% if (!bookings.length) { %>
  <%- include('../../partials/admin-empty') %>
<% } else { %>
  <div class="admin-table-wrap admin-panel">
    <table class="admin-table admin-table--compact">
      <thead>
        <tr>
          <th>ID</th>
          <th><%= t('admin.table.customer', 'Customer') %></th>
          <th><%= t('admin.table.trip', 'Trip') %></th>
          <th><%= t('admin.table.company', 'Company') %></th>
          <th><%= t('admin.table.amount', 'Amount') %></th>
          <th><%= t('admin.table.status', 'Status') %></th>
          <th><%= t('admin.finance.paymentStatus', 'Payment') %></th>
        </tr>
      </thead>
      <tbody>
        <% bookings.forEach(function(b) { %>
          <tr>
            <td><a href="/admin/bookings/<%= b.id %>" class="admin-link"><%= b.id %></a></td>
            <td><%= b.customerName %></td>
            <td><%= b.tripName %></td>
            <td><%= b.company ? b.company.title : b.companyId %></td>
            <td><%= formatPrice(b.totalPrice) %> <%= t('shared.egp', 'EGP') %></td>
            <td><span class="admin-status admin-status--<%= b.status.toLowerCase() %>"><%= statusLabel(b.status) %></span></td>
            <td><span class="admin-status admin-status--<%= (b.paymentStatus || 'unpaid') %>"><%= t('company.paymentStatus.' + String(b.paymentStatus || 'unpaid').toLowerCase(), statusLabel(b.paymentStatus || 'unpaid')) %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../../partials/admin-pagination', { filterQuery: filterQuery }) %>
<% } %>
<%- include('../../partials/admin-shell-end') %>
