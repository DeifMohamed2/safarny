<%
  const isUmrah = trip.type === 'umrah';
  const tripTypeLabel = isUmrah ? t('filter.umrah', 'Umrah') : t('filter.leisure', 'Leisure');
  const occupancy = typeof occupancyOf === 'function' ? occupancyOf(trip) : Math.min(4, Math.max(1, Number(trip.beds) || 2));
  const initialDate = tripDates[0];
  const initialMaxRooms = initialDate?.maxRooms ?? 0;
  const canBookInitial = initialMaxRooms > 0;
  const sleepsHint = t('tripDetails.roomSleepsHint', 'This room sleeps {n}').replace('{n}', String(occupancy));
  const stayLine = typeof staySummary === 'function' ? staySummary(trip) : '';
  const includedItems = (trip.includedList && trip.includedList.length)
    ? trip.includedList.map(function(text) { return { text: text, custom: true }; })
    : isUmrah
      ? [
          { key: 'visa', icon: 'M4 6h16v12H4zM8 10h8M8 14h5' },
          { key: 'hotel', icon: 'M3 20h18M5 20V9l7-5 7 5v11M9 20v-6h6v6' },
          { key: 'transfer', icon: 'M3 12h18M5 17h2M17 17h2M7 12l1.5-4h7L17 12' },
          { key: 'ziyarat', icon: 'M12 2l2.4 7.4H22l-6 4.6 2.3 7L12 17.8 5.7 21.2 8 14 2 9.4h7.6z' },
        ]
      : [
          { key: 'hotel', icon: 'M3 20h18M5 20V9l7-5 7 5v11M9 20v-6h6v6' },
          { key: 'breakfast', icon: 'M6 3h12v4H6zM4 10h16v10H4zM8 14h8' },
          { key: 'transport', icon: 'M3 12h18M5 17h2M17 17h2M7 12l1.5-4h7L17 12' },
          { key: 'activities', icon: 'M12 2l2.4 7.4H22l-6 4.6 2.3 7L12 17.8 5.7 21.2 8 14 2 9.4h7.6z' },
        ];
  const overviewItems = [
    { label: t('tripDetails.tripType', 'Trip Type'), value: tripTypeLabel },
    { label: t('tripDetails.destination', 'Destination'), value: trip.destination },
    { label: t('tripDetails.duration', 'Duration'), value: trip.days + ' ' + t('tripDetails.durationDays', 'Days') + ' / ' + trip.nights + ' ' + t('tripDetails.durationNights', 'Nights') },
    { label: t('tripDetails.roomOccupancy', 'Room occupancy'), value: trip.roomTypesLabel || occupancySleepsLabel(trip.beds) },
    { label: t('tripDetails.schedule', 'Schedule'), value: trip.frequency || t('tripDetails.scheduleDaily', 'Daily') },
  ];
  if (stayLine) overviewItems.splice(2, 0, { label: t('tripDetails.stayPlan', 'Stay plan'), value: stayLine });
%>

<section class="trip-details-page<%= isUmrah ? ' trip-details-page--umrah' : '' %>">
  <div class="trip-details-shell max-w-340 w-full px-4 pt-28 sm:pt-32 pb-10 sm:pb-16 mx-auto">
    <a href="<%= isUmrah ? '/umrah' : '/trips' %>" class="trip-details-back animate-on-load" style="--load-delay: 0s">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <%= isUmrah ? t('umrah.back', 'Back to Umrah') : t('tripDetails.backToTrips', 'Back to trips') %>
    </a>

    <div class="trip-details-gallery animate-on-load" data-gallery style="--load-delay: 0.06s">
      <div class="trip-details-gallery-main-wrap">
        <div
          data-gallery-main
          class="trip-details-gallery-main"
          style="background-image: url('<%= trip.gallery[0] %>')"
          role="img"
          aria-label="<%= trip.title %>"
        ></div>
        <div class="trip-details-gallery-badges">
          <span class="trip-details-pill trip-details-pill--dest"><%= trip.destination %></span>
          <span class="trip-details-pill trip-details-pill--type"><%= tripTypeLabel %></span>
        </div>
      </div>
      <div class="trip-details-gallery-thumbs-wrap" data-gallery-thumbs-wrap>
        <div class="trip-details-gallery-thumbs" data-gallery-thumbs>
          <% trip.gallery.forEach(function(image, index) { %>
            <button
              type="button"
              data-gallery-thumb
              class="trip-details-gallery-thumb <%= index === 0 ? 'is-active' : '' %>"
              style="background-image: url('<%= image %>')"
              aria-label="<%= t('tripDetails.galleryImage', 'Gallery image') %> <%= index + 1 %>"
            ></button>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="trip-details-layout">
      <div class="trip-details-main">
        <header class="trip-details-header" data-scroll-reveal>
          <div class="trip-details-header-top">
            <span class="trip-details-category"><%= isUmrah ? t('filter.umrah', 'Umrah') : trip.category %></span>
            <% if (trip.discountPercent) { %>
              <span class="trip-details-save-badge"><%= t('tripDetails.save', 'Save') %> <%= trip.discountPercent %>%</span>
            <% } %>
          </div>
          <h1 class="trip-details-title"><%= trip.title %></h1>
          <ul class="trip-details-meta">
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="10" r="2.2" fill="currentColor"/></svg>
              <%= trip.location %>
            </li>
            <% if (stayLine) { %>
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h7l7 7v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" stroke="currentColor" stroke-width="1.6"/><path d="M13 3v6h6" stroke="currentColor" stroke-width="1.6"/></svg>
              <%= stayLine %>
            </li>
            <% } %>
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 20h18M5 20V9l7-5 7 5v11M9 20v-6h6v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <%= trip.roomTypesLabel || bedTypeLabel(trip.beds) %>
            </li>
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="15" rx="2.2" stroke="currentColor" stroke-width="1.6"/><path d="M8 3.5v3M16 3.5v3M3.5 10h17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              <%= trip.days %> <%= t('tripDetails.durationDays', 'Days') %> / <%= trip.nights %> <%= t('tripDetails.durationNights', 'Nights') %>
            </li>
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="7" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              <%= trip.availableSpots %> <%= t('tripDetails.spotsLeft', 'spots left') %>
            </li>
          </ul>
        </header>

        <div class="trip-details-price-block" data-scroll-reveal style="--reveal-delay: 80ms">
          <div class="trip-details-price-main">
            <span class="trip-details-price-current"><%= trip.hasMultipleRoomTypes ? t('tripDetails.fromPrice', 'From') + ' ' : '' %><%= formatPrice(trip.price) %> <small><%= t('shared.egp', 'EGP') %></small></span>
            <span class="trip-details-price-unit">/ <%= t('tripDetails.person', 'person') %></span>
          </div>
          <% if (trip.oldPrice) { %>
            <span class="trip-details-price-old"><%= formatPrice(trip.oldPrice) %> <%= t('shared.egp', 'EGP') %></span>
          <% } %>
        </div>

        <section class="trip-details-section" data-scroll-reveal style="--reveal-delay: 120ms">
          <h2 class="trip-details-section-title"><%= t('tripDetails.aboutTrip', 'About This Trip') %></h2>
          <p class="trip-details-about"><%= trip.about %></p>
        </section>

        <section class="trip-details-section" data-scroll-reveal style="--reveal-delay: 160ms">
          <h2 class="trip-details-section-title"><%= t('tripDetails.tripOverview', 'Trip Overview') %></h2>
          <div class="trip-details-overview-grid">
            <% overviewItems.forEach(function(item) { %>
              <div class="trip-details-overview-item">
                <span class="trip-details-overview-label"><%= item.label %></span>
                <span class="trip-details-overview-value"><%= item.value %></span>
              </div>
            <% }) %>
          </div>
        </section>

        <%- include('../partials/trip-itinerary', { trip: trip, variant: 'main' }) %>

        <section class="trip-details-section" data-scroll-reveal style="--reveal-delay: 200ms">
          <h2 class="trip-details-section-title"><%= t('tripDetails.whatsIncluded', "What's Included") %></h2>
          <ul class="trip-details-included">
            <% includedItems.forEach(function(item, index) { %>
              <li class="trip-details-included-item" style="--item-delay: <%= index * 70 %>ms">
                <span class="trip-details-included-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <% if (item.custom) { %>
                      <path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <% } else { %>
                      <path d="<%= item.icon %>" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <% } %>
                  </svg>
                </span>
                <span><%= item.custom ? item.text : t('tripDetails.included.' + item.key) %></span>
              </li>
            <% }) %>
          </ul>
        </section>

        <a href="/trips/<%= trip.id %>/checkout?dateId=<%= tripDates[0].id %>&roomType=<%= tripDates[0].defaultRoomType || '' %>&rooms=1" class="trip-details-book-mobile<%= canBookInitial ? '' : ' is-disabled' %>" id="trip-checkout-link-mobile" data-price-label="<%= formatPrice(trip.price) %> <%= t('shared.egp', 'EGP') %>" data-scroll-reveal style="--reveal-delay: 240ms" <%= canBookInitial ? '' : 'aria-disabled="true"' %>>
          <%= canBookInitial ? t('tripDetails.book', 'Book') + ' — ' + formatPrice(trip.price) + ' ' + t('shared.egp', 'EGP') : t('tripDetails.soldOutDate', 'Sold out for this date') %>
        </a>
      </div>

      <aside class="trip-details-sidebar" data-trip-select data-occupancy="<%= occupancy %>" data-room-label="<%= bedTypeLabel(trip.beds) %>" data-scroll-reveal style="--reveal-delay: 100ms">
        <div class="trip-details-sidebar-sticky">
          <div class="trip-date-card">
            <p class="trip-date-card-label"><%= t('tripDetails.selectDate', 'Select travel date') %></p>
            <button type="button" class="trip-date-card-trigger" data-trip-toggle aria-expanded="false">
              <span class="trip-date-card-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <rect x="3.4" y="5.2" width="17.2" height="15.4" rx="2.4" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M8 3.5v3.4M16 3.5v3.4M3.4 10h17.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="trip-date-card-body">
                <span data-selected-date class="trip-date-card-date"><%= tripDates[0].date %></span>
                <span class="trip-date-card-meta">
                  <span><%= t('tripDetails.guestSpotsLeft', 'guest spots left') %>: <strong data-selected-spots><%= tripDates[0].availableSpots %></strong></span>
                  <span data-selected-duration><%= tripDates[0].days %> <%= t('tripDetails.durationDays') %> / <%= tripDates[0].nights %> <%= t('tripDetails.durationNights') %></span>
                </span>
              </span>
              <span class="trip-date-card-chevron" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </button>
            <p class="trip-occupancy-hint" data-trip-occupancy-hint><%= sleepsHint %></p>
            <div data-trip-menu class="trip-date-menu" role="listbox" aria-hidden="true">
              <% tripDates.forEach(function(date, index) { %>
                <button
                  type="button"
                  data-trip-option
                  data-date-id="<%= date.id %>"
                  data-date="<%= date.date %>"
                  data-spots="<%= date.availableSpots %>"
                  data-max-rooms="<%= date.maxRooms %>"
                  data-max-guests="<%= date.maxGuests %>"
                  data-rooms='<%= JSON.stringify(date.rooms || []) %>'
                  data-default-room="<%= date.defaultRoomType || '' %>"
                  data-duration="<%= date.days %> <%= t('tripDetails.durationDays') %> / <%= date.nights %> <%= t('tripDetails.durationNights') %>"
                  class="trip-date-option <%= index === 0 ? 'is-selected' : '' %>"
                  role="option"
                >
                  <span class="trip-date-option-date"><%= date.date %></span>
                  <span class="trip-date-option-meta"><%= t('tripDetails.guestSpotsLeft', 'guest spots left') %>: <%= date.availableSpots %></span>
                </button>
              <% }) %>
              <button type="button" data-open-dialog="#dates-dialog" class="trip-date-see-all"><%= t('shared.see_all', 'See all dates') %></button>
            </div>
          </div>

          <div class="trip-room-picker" data-trip-rooms>
            <p class="trip-date-card-label"><%= t('checkout.roomType', 'Room type') %></p>
            <div class="trip-room-picker-list" data-trip-room-list>
              <% (tripDates[0].rooms && tripDates[0].rooms.length ? tripDates[0].rooms : (trip.roomTypes || [])).forEach(function(room, index) { %>
                <button
                  type="button"
                  class="trip-room-picker-card <%= index === 0 ? 'is-selected' : '' %>"
                  data-trip-room
                  data-room-type="<%= room.type %>"
                  data-price="<%= room.price || trip.price %>"
                  data-max-rooms="<%= room.maxRooms || 0 %>"
                  data-occupancy="<%= room.occupancy %>"
                >
                  <strong><%= roomTypeLabel(room.type) %></strong>
                  <span><%= formatPrice(room.price || trip.price) %> <%= t('shared.egp', 'EGP') %> / <%= t('tripDetails.person', 'person') %></span>
                  <em><%= t('tripDetails.sleepsN', 'sleeps {n}').replace('{n}', String(room.occupancy)) %></em>
                </button>
              <% }) %>
            </div>
          </div>

          <a href="/trips/<%= trip.id %>/checkout?dateId=<%= tripDates[0].id %>&roomType=<%= tripDates[0].defaultRoomType || '' %>&rooms=1" class="trip-details-book-btn<%= canBookInitial ? '' : ' is-disabled' %>" id="trip-checkout-link" <%= canBookInitial ? '' : 'aria-disabled="true"' %>>
            <%= canBookInitial ? t('tripDetails.book', 'Book') : t('tripDetails.soldOutDate', 'Sold out for this date') %>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </aside>
    </div>
  </div>
</section>

<%- include('../partials/trips-section', {
  title1: '',
  title2: 'tripDetails.recommended.title1',
  title3: 'tripDetails.recommended.title2',
  description: 'tripDetails.recommended.description',
  actionText: 'tripDetails.recommended.seeMore',
  actionLink: isUmrah ? '/umrah' : '/trips',
  trips: recommendedTrips
}) %>
