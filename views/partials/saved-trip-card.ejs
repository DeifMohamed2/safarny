<% const favorite = favorites.includes(String(trip.id)); %>
<article class="saved-trip-card">
  <a href="/trips/<%= trip.id %>" class="saved-trip-card-media">
    <img src="<%= trip.image %>" alt="" class="saved-trip-card-img" loading="lazy" />
    <% if (trip.discountPercent) { %>
      <span class="saved-trip-card-badge">-<%= trip.discountPercent %>%</span>
    <% } %>
  </a>
  <div class="saved-trip-card-body">
    <div class="saved-trip-card-head">
      <div class="saved-trip-card-text">
        <span class="saved-trip-card-category"><%= trip.category %></span>
        <h3 class="saved-trip-card-title">
          <a href="/trips/<%= trip.id %>"><%= trip.title %></a>
        </h3>
        <p class="saved-trip-card-meta">
          <%= trip.location %> · <%= bedTypeLabel(trip.beds) %> · <%= trip.days %> <%= t('tripDetails.durationDays', 'Days') %> / <%= trip.nights %> <%= t('tripDetails.durationNights', 'Nights') %>
        </p>
      </div>
      <button type="button" data-favorite="<%= trip.id %>" class="saved-trip-card-fav" aria-label="<%= t('shared.favorite', 'Favorite') %>">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="16" viewBox="0 0 22 20" fill="<%= favorite ? '#EF7722' : 'none' %>" aria-hidden="true">
          <path d="M6.02778 0.75C3.11333 0.75 0.75 3.14294 0.75 6.09388C0.75 12 10.75 18.75 10.75 18.75C10.75 18.75 20.75 12 20.75 6.09388C20.75 2.43776 18.3867 0.75 15.4722 0.75C13.4056 0.75 11.6167 1.95282 10.75 3.70412C9.88333 1.95282 8.09444 0.75 6.02778 0.75Z" stroke="#EF7722" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <div class="saved-trip-card-foot">
      <p class="saved-trip-card-price">
        <span class="saved-trip-card-price-value"><%= formatPrice(trip.price) %></span>
        <span class="saved-trip-card-price-unit"><%= t('shared.egp', 'EGP') %> / <%= t('tripDetails.person', 'person') %></span>
      </p>
      <a href="/trips/<%= trip.id %>" class="saved-trip-card-link">
        <%= t('shared.viewDetails', 'View Details') %>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</article>
