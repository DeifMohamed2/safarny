<%
  const activeSection = typeof adminActive !== 'undefined' ? adminActive : '';
  const currentRange = typeof range !== 'undefined' ? range : '30d';
  const badges = typeof adminBadges !== 'undefined' ? adminBadges : { trips: 0, support: 0, finance: 0, payouts: 0, refunds: 0 };
  const navGroups = [
    {
      label: t('admin.nav.overview', 'Overview'),
      links: [
        { id: 'dashboard', href: '/admin/dashboard', label: t('admin.nav.dashboard', 'Dashboard'), icon: 'dashboard' },
        { id: 'analytics', href: '/admin/analytics', label: t('admin.nav.analytics', 'Analytics'), icon: 'analytics' },
      ],
    },
    {
      label: t('admin.nav.marketplace', 'Marketplace'),
      links: [
        { id: 'companies', href: '/admin/companies', label: t('admin.nav.companies', 'Companies'), icon: 'companies' },
        { id: 'trips', href: '/admin/trips', label: t('admin.nav.trips', 'Trips'), icon: 'trips', badge: badges.trips },
        { id: 'bookings', href: '/admin/bookings', label: t('admin.nav.bookings', 'Bookings'), icon: 'bookings' },
        { id: 'reviews', href: '/admin/reviews', label: t('admin.nav.reviews', 'Reviews'), icon: 'reviews' },
      ],
    },
    {
      label: t('admin.nav.finance', 'Finance'),
      links: [
        { id: 'finance', href: '/admin/finance', label: t('admin.nav.financeOverview', 'Overview'), icon: 'finance' },
        { id: 'finance-payments', href: '/admin/finance/payments', label: t('admin.nav.payments', 'Payments'), icon: 'payments', badge: badges.finance },
        { id: 'finance-payouts', href: '/admin/finance/payouts', label: t('admin.nav.payouts', 'Payouts'), icon: 'payouts', badge: badges.payouts },
        { id: 'finance-refunds', href: '/admin/finance/refunds', label: t('admin.nav.refunds', 'Refunds'), icon: 'refunds', badge: badges.refunds },
      ],
    },
    {
      label: t('admin.nav.people', 'People'),
      links: [
        { id: 'travelers', href: '/admin/travelers', label: t('admin.nav.travelers', 'Travelers'), icon: 'travelers' },
        { id: 'admins', href: '/admin/admins', label: t('admin.nav.admins', 'Admins'), icon: 'admins' },
        { id: 'support', href: '/admin/support', label: t('admin.nav.support', 'Support'), icon: 'support', badge: badges.support },
      ],
    },
    {
      label: t('admin.nav.system', 'System'),
      links: [
        { id: 'settings', href: '/admin/settings', label: t('admin.nav.settings', 'Settings'), icon: 'settings' },
        { id: 'audit', href: '/admin/audit', label: t('admin.nav.audit', 'Audit log'), icon: 'audit' },
      ],
    },
  ];
  const titles = {
    dashboard: t('admin.dashboard.title', 'Dashboard'),
    analytics: t('admin.analytics.title', 'Analytics'),
    companies: t('admin.companies.title', 'Companies'),
    trips: t('admin.trips.title', 'Trips'),
    bookings: t('admin.bookings.title', 'Bookings'),
    reviews: t('admin.reviews.title', 'Reviews'),
    travelers: t('admin.travelers.title', 'Travelers'),
    admins: t('admin.admins.title', 'Admins'),
    support: t('admin.support.title', 'Support'),
    finance: t('admin.finance.title', 'Finance'),
    'finance-payments': t('admin.finance.payments', 'Payments'),
    'finance-payouts': t('admin.finance.payouts.title', 'Payouts'),
    'finance-refunds': t('admin.finance.refunds.title', 'Refunds'),
    settings: t('admin.settings.title', 'Settings'),
    audit: t('admin.audit.title', 'Audit log'),
  };
  const pageTitle = titles[activeSection] || t('admin.portal', 'Admin portal');
  function navIcon(name) {
    const icons = {
      dashboard: '<rect x="3" y="3" width="7" height="9" rx="1.5" stroke="currentColor" stroke-width="1.7"/><rect x="14" y="3" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="1.7"/><rect x="14" y="12" width="7" height="9" rx="1.5" stroke="currentColor" stroke-width="1.7"/><rect x="3" y="16" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="1.7"/>',
      analytics: '<path d="M4 19V5M4 19h16M8 15v-4M12 19V9M16 13V7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
      companies: '<path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>',
      trips: '<rect x="4" y="6" width="16" height="13" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8 6V5a4 4 0 0 1 8 0v1" stroke="currentColor" stroke-width="1.7"/>',
      bookings: '<path d="M7 4h10a2 2 0 0 1 2 2v14l-7-3-7 3V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>',
      reviews: '<path d="M12 17.3 6.2 20l1.2-6.6L2 8.7l6.7-1L12 1.5l3.3 6.2 6.7 1-5.4 4.7 1.2 6.6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>',
      travelers: '<circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7"/><path d="M4 20c0-3.3 3.6-6 8-6s8 2.7 8 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
      admins: '<path d="M12 14.5c-2.5 0-4.5 1.5-4.5 3.5v1h9v-1c0-2-2-3.5-4.5-3.5Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.7"/><path d="M5 6.5 3 5M19 5l-2 1.5M5 18h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
      users: '<circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7"/><path d="M4 20c0-3.3 3.6-6 8-6s8 2.7 8 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
      support: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke="currentColor" stroke-width="1.7"/>',
      finance: '<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
      payments: '<rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M2 10h20" stroke="currentColor" stroke-width="1.7"/>',
      payouts: '<path d="M12 3v18M8 7h7.5a3 3 0 0 1 0 6H9m0 0h6.5a3 3 0 0 1 0 6H8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
      refunds: '<path d="M4 12a8 8 0 1 0 3-6.3M4 4v5h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
      settings: '<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/><path d="M12 5v2M12 17v2M5 12h2M17 12h2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
      audit: '<path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2" stroke="currentColor" stroke-width="1.7"/>',
    };
    return icons[name] || icons.dashboard;
  }
%>
<div class="adm-app">
  <div class="adm-sidebar-backdrop" data-adm-close hidden></div>
  <aside class="adm-sidebar" data-adm-sidebar>
    <div class="adm-brand">
      <a href="/admin/dashboard" class="adm-brand-logo" aria-label="Safarny Admin">
        <img src="/assets/white-logo.svg" alt="Safarny" class="adm-logo adm-logo--dark" />
        <img src="/assets/logo.svg" alt="Safarny" class="adm-logo adm-logo--light" />
      </a>
      <p class="adm-brand-kicker"><%= t('admin.portal', 'Admin portal') %></p>
    </div>
    <nav class="adm-nav" aria-label="<%= t('admin.nav.label', 'Admin') %>">
      <% navGroups.forEach(function(group) { %>
        <div class="adm-nav-group">
          <p class="adm-nav-group-label"><%= group.label %></p>
          <% group.links.forEach(function(link) { %>
            <a href="<%= link.href %>" class="adm-nav-link <%= activeSection === link.id ? 'is-active' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><%- navIcon(link.icon) %></svg>
              <span><%= link.label %></span>
              <% if (link.badge && link.badge > 0) { %>
                <span class="adm-nav-badge"><%= link.badge %></span>
              <% } %>
            </a>
          <% }) %>
        </div>
      <% }) %>
    </nav>
    <div class="adm-sidebar-foot">
      <a href="/" class="adm-nav-link adm-nav-link--ghost">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4M10 8l-4 4 4 4M6 12h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span><%= t('admin.nav.marketplace', 'View marketplace') %></span>
      </a>
      <button type="button" data-open-dialog="#admin-signout-dialog" class="adm-nav-link adm-nav-link--danger">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M10 7V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-8a1 1 0 0 1-1-1v-2M4 12h11M8 8l-4 4 4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span><%= t('shared.logOut', 'Log Out') %></span>
      </button>
    </div>
  </aside>
  <div class="adm-workspace">
    <header class="adm-topbar">
      <div class="adm-topbar-start">
        <button type="button" class="adm-menu-btn" data-adm-toggle aria-label="<%= t('admin.nav.menu', 'Menu') %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
        <div>
          <p class="adm-crumb"><%= t('admin.portal', 'Admin portal') %></p>
          <h1 class="adm-topbar-title"><%= pageTitle %></h1>
        </div>
      </div>
      <div class="adm-topbar-end">
        <form action="/admin/dashboard" method="get" class="adm-search" data-adm-range-form>
          <select name="range" class="admin-input admin-input--sm" data-adm-range>
            <option value="7d" <%= currentRange === '7d' ? 'selected' : '' %>><%= t('admin.range.7d', 'Last 7 days') %></option>
            <option value="30d" <%= currentRange === '30d' ? 'selected' : '' %>><%= t('admin.range.30d', 'Last 30 days') %></option>
            <option value="90d" <%= currentRange === '90d' ? 'selected' : '' %>><%= t('admin.range.90d', 'Last 90 days') %></option>
            <option value="12m" <%= currentRange === '12m' ? 'selected' : '' %>><%= t('admin.range.12m', 'Last 12 months') %></option>
            <option value="all" <%= currentRange === 'all' ? 'selected' : '' %>><%= t('admin.range.all', 'All time') %></option>
          </select>
        </form>
        <button
          type="button"
          class="adm-theme-btn"
          data-adm-theme-toggle
          aria-label="<%= t('admin.theme.toggle', 'Toggle theme') %>"
          title="<%= t('admin.theme.toggle', 'Toggle theme') %>"
        >
          <svg class="adm-theme-icon adm-theme-icon--sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/>
            <path d="M12 3v2M12 19v2M5 12H3M21 12h-2M5.6 5.6 4.2 4.2M19.8 19.8l-1.4-1.4M18.4 5.6l1.4-1.4M4.2 19.8l1.4-1.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
          <svg class="adm-theme-icon adm-theme-icon--moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 7 7 0 1 0 20 14.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="relative" data-dropdown>
          <button type="button" data-dropdown-trigger class="adm-chip">
            <img src="<%= isRtl ? '/assets/icons/flags/Egypt.png' : '/assets/icons/flags/UnitedStates.svg' %>" alt="" />
            <span><%= isRtl ? 'العربية' : 'English' %></span>
          </button>
          <div data-dropdown-menu class="dropdown-menu site-dropdown end-0">
            <a href="/lang/en?redirect=<%= encodeURIComponent(currentPath) %>" class="<%= !isRtl ? 'is-current' : '' %>">English</a>
            <a href="/lang/ar?redirect=<%= encodeURIComponent(currentPath) %>" class="<%= isRtl ? 'is-current' : '' %>">العربية</a>
          </div>
        </div>
        <div class="adm-user">
          <img src="<%= user.avatar || '/user.png' %>" alt="" />
          <span><%= user.userName %></span>
        </div>
      </div>
    </header>
    <div class="adm-content" data-adm-content>
