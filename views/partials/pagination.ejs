<% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
  <div class="w-full flex justify-center mt-7 <%= isRtl ? 'rtl-pagination' : '' %>">
    <ul class="pagination-custom">
      <li class="<%= pagination.current === 1 ? 'is-disabled' : '' %>">
        <% if (pagination.current === 1) { %><span>‹</span><% } else { %><a href="<%= pageUrl(pagination.current - 1) %>">‹</a><% } %>
      </li>
      <% pagination.pages.forEach(function(page) { %>
        <li class="<%= page === pagination.current ? 'is-active' : '' %>">
          <a href="<%= pageUrl(page) %>"><%= page %></a>
        </li>
      <% }) %>
      <li class="<%= pagination.current === pagination.totalPages ? 'is-disabled' : '' %>">
        <% if (pagination.current === pagination.totalPages) { %><span>›</span><% } else { %><a href="<%= pageUrl(pagination.current + 1) %>">›</a><% } %>
      </li>
    </ul>
  </div>
<% } %>
