<section class="quotes-section max-w-340 w-full px-4 mx-auto flex flex-col items-center gap-12 pt-20 pb-25">
  <div class="flex flex-col items-center gap-2" data-scroll-reveal>
    <h2 class="text-orange-500 text-2xl sm:text-3xl lg:text-4xl font-semibold capitalize">
      <%= t('home.quotes.title', 'Quotes') %>
    </h2>
    <p class="text-center text-sky-950 text-sm sm:text-base lg:text-xl">
      <%= t('home.quotes.subtitle', 'Experiences shared by travelers who found their trips here') %>
    </p>
  </div>
  <div class="quotes-scroll w-full p-1 flex gap-6 overflow-x-auto scrollbar-hide" data-drag-scroll>
    <% reviews.forEach(function(review, index) { %>
      <article class="quote-card" data-scroll-reveal data-reveal-delay="<%= (index % 3) * 80 %>">
        <div class="flex items-center gap-4">
          <img src="<%= review.avatar %>" alt="<%= review.name %>" class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl border-2 border-sky-950 object-cover" />
          <span class="text-black text-base sm:text-xl lg:text-2xl font-medium"><%= review.name %></span>
        </div>
        <p class="text-neutral-600 text-sm sm:text-base lg:text-lg"><%= review.message %></p>
      </article>
    <% }) %>
  </div>
</section>
