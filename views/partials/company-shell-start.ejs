<%
  const activeSection = typeof companyActive !== 'undefined' ? companyActive : '';
  const companyLinks = [
    { id: 'dashboard', href: '/company/dashboard', label: t('company.nav.dashboard', 'Dashboard'), icon: 'home' },
    { id: 'trips', href: '/company/trips', label: t('company.nav.trips', 'Trips'), icon: 'trips' },
    { id: 'bookings', href: '/company/bookings', label: t('company.nav.bookings', 'Bookings'), icon: 'bookings' },
    { id: 'support', href: '/company/support', label: t('company.nav.support', 'Support'), icon: 'support' },
    { id: 'settings', href: '/company/settings', label: t('company.nav.settings', 'Settings'), icon: 'settings' },
  ];
  const titles = {
    dashboard: t('company.dashboard.title', 'Dashboard'),
    trips: t('company.trips.title', 'Trips'),
    bookings: t('company.bookings.title', 'Bookings'),
    support: t('company.support.title', 'Support'),
    settings: t('company.settings.title', 'Settings'),
  };
  const pageTitle = titles[activeSection] || t('company.portal', 'Company portal');
  const companyName = company ? company.title : user.userName;
  const companyLogo = company && company.image ? company.image : (user.avatar || '/user.png');
  function navIcon(name) {
    if (name === 'home') return '<path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>';
    if (name === 'trips') return '<rect x="4" y="6" width="16" height="13" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8 6V5a4 4 0 0 1 8 0v1M8 12h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>';
    if (name === 'bookings') return '<path d="M7 4h10a2 2 0 0 1 2 2v14l-7-3-7 3V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>';
    if (name === 'support') return '<path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>';
    if (name === 'chat') return '<path d="M5 18.5 6.2 15A7.5 7.5 0 1 1 12 19.5H7.5L5 18.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>';
    return '<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/><path d="M12 5v2M12 17v2M5 12h2M17 12h2M7.2 7.2l1.4 1.4M15.4 15.4l1.4 1.4M7.2 16.8l1.4-1.4M15.4 8.6l1.4-1.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>';
  }
%>
<div class="cp-app">
  <div class="cp-sidebar-backdrop" data-cp-close hidden></div>
  <aside class="cp-sidebar" data-cp-sidebar>
    <div class="cp-brand">
      <a href="/company/dashboard" class="cp-brand-logo" aria-label="Safarny">
        <img src="/assets/white-logo.svg" alt="Safarny" />
      </a>
      <p class="cp-brand-kicker"><%= t('company.portal', 'Company portal') %></p>
    </div>

    <div class="cp-company">
      <img src="<%= companyLogo %>" alt="" class="cp-company-logo" />
      <div class="cp-company-meta">
        <p class="cp-company-name"><%= companyName %></p>
        <p class="cp-company-mail"><%= user.email %></p>
      </div>
    </div>

    <nav class="cp-nav" aria-label="<%= t('company.nav.label', 'Company') %>">
      <% companyLinks.forEach(function(link) { %>
        <a href="<%= link.href %>" class="cp-nav-link <%= activeSection === link.id ? 'is-active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><%- navIcon(link.icon) %></svg>
          <span><%= link.label %></span>
        </a>
      <% }) %>
    </nav>

    <div class="cp-sidebar-foot">
      <a href="/" class="cp-nav-link cp-nav-link--ghost">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4M10 8l-4 4 4 4M6 12h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span><%= t('company.nav.marketplace', 'View marketplace') %></span>
      </a>
      <button type="button" data-open-dialog="#signout-dialog" class="cp-nav-link cp-nav-link--danger">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M10 7V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-8a1 1 0 0 1-1-1v-2M4 12h11M8 8l-4 4 4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span><%= t('shared.logOut', 'Log Out') %></span>
      </button>
      <div class="cp-sidebar-brand-foot" aria-hidden="true">
        <img src="/assets/white-logo.svg" alt="" />
      </div>
    </div>
  </aside>

  <div class="cp-workspace">
    <header class="cp-topbar">
      <div class="cp-topbar-start">
        <button type="button" class="cp-menu-btn" data-cp-toggle aria-label="<%= t('company.nav.menu', 'Menu') %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
        <div>
          <p class="cp-crumb"><%= t('company.portal', 'Company portal') %></p>
          <h1 class="cp-topbar-title"><%= pageTitle %></h1>
        </div>
      </div>
      <div class="cp-topbar-end">
        <div class="relative" data-dropdown>
          <button type="button" data-dropdown-trigger class="cp-chip">
            <img src="<%= isRtl ? '/assets/icons/flags/Egypt.png' : '/assets/icons/flags/UnitedStates.svg' %>" alt="" />
            <span><%= isRtl ? 'العربية' : 'English' %></span>
          </button>
          <div data-dropdown-menu class="dropdown-menu site-dropdown end-0">
            <a href="/lang/en?redirect=<%= encodeURIComponent(currentPath) %>" class="<%= !isRtl ? 'is-current' : '' %>">English</a>
            <a href="/lang/ar?redirect=<%= encodeURIComponent(currentPath) %>" class="<%= isRtl ? 'is-current' : '' %>">العربية</a>
          </div>
        </div>
        <div class="cp-user">
          <img src="<%= companyLogo %>" alt="" />
          <span><%= companyName %></span>
        </div>
      </div>
    </header>
    <div class="cp-content" data-cp-content>
      <% if (company && company.verification === 'pending') { %>
        <div class="cp-verify-banner"><%= t('partner.pendingBanner', 'Your company is under review. You can set up trips now — they go live after Safarny verifies your account.') %></div>
      <% } else if (company && company.verification === 'rejected') { %>
        <div class="cp-verify-banner is-rejected"><%= t('partner.rejectedBanner', 'Verification was not approved. Contact Safarny support if you need help.') %></div>
      <% } %>
