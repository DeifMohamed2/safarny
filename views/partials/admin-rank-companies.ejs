<div class="admin-rank-strip">
  <% items.forEach(function(item) { %>
    <a href="/admin/companies/<%= item.id %>" class="admin-rank-card">
      <span class="admin-rank-pos admin-rank-pos--<%= item.rank %>">#<%= item.rank %></span>
      <% if (item.image) { %>
        <img src="<%= item.image %>" alt="" class="admin-rank-card-media" />
      <% } else { %>
        <div class="admin-rank-card-media admin-rank-card-media--placeholder"><%= (item.name || item.title || '?').charAt(0) %></div>
      <% } %>
      <div class="admin-rank-card-body">
        <p class="admin-rank-name"><%= item.name || item.title %></p>
        <p class="admin-rank-sub"><%= item.location || '' %></p>
        <p class="admin-rank-meta-line">
          <%= item.bookings != null ? item.bookings : item.confirmedBookings %> <%= t('admin.kpi.bookings', 'bookings') %>
          · <%= item.activeTrips %> <%= t('admin.kpi.trips', 'trips') %>
        </p>
        <div class="admin-rank-stats">
          <span class="admin-metric-pill"><%= formatPrice(item.revenue) %> EGP</span>
          <span class="admin-metric-pill admin-metric-pill--profit"><%= formatPrice(item.platformProfit) %> <%= t('admin.profit', 'profit') %></span>
        </div>
      </div>
    </a>
  <% }) %>
</div>
