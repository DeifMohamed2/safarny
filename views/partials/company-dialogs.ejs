<%- include('auth-dialog') %>

<div id="signout-dialog" class="dialog-overlay">
  <div class="dialog-panel px-4 py-6.5">
    <p class="text-center text-lg font-medium"><%= t('shared.wantLogout', 'Are you sure you want to log out ?!') %></p>
    <div class="flex justify-center gap-8 mt-6">
      <button type="button" data-close-dialog="#signout-dialog" class="flex-1 max-w-43.5 py-3 border border-[#263859] rounded-xl"><%= t('shared.no', 'No') %></button>
      <form id="sign-out-form" action="/auth/sign-out" method="post" class="flex-1 max-w-43.5">
        <button type="submit" class="w-full py-3 bg-[#263859] text-white rounded-xl"><%= t('shared.yes', 'Yes') %></button>
      </form>
    </div>
  </div>
</div>
