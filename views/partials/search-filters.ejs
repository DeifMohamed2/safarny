<%
  const currentFilters = typeof filters !== 'undefined' && filters ? filters : {};
  const action = typeof filterAction !== 'undefined' ? filterAction : '/search';
  const variant = typeof filterVariant !== 'undefined' ? filterVariant : 'hero';
  const isHero = variant === 'hero';
  const lockTripType = action === '/umrah' ? 'umrah' : (action === '/trips' || action === '/trips/offers' ? 'leisure' : '');
  const offersOnly = String(action).indexOf('offers') !== -1;
  const panelId = 'filters-' + variant;
  const formId = 'filter-form-' + variant;
  const formatChipDate = function(value) {
    if (!value) return '';
    const date = new Date(String(value).slice(0, 10) + 'T12:00:00');
    if (Number.isNaN(date.getTime())) return value;
    return date.toLocaleDateString(lang === 'ar' ? 'ar-EG' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  };
  const chipFields = [];
  if (currentFilters.destination) chipFields.push({ key: 'destination', label: t('filter.destination', 'Destination'), value: currentFilters.destination });
  if (currentFilters.date) chipFields.push({ key: 'date', label: t('filter.date', 'Date'), value: formatChipDate(currentFilters.date) });
  if (currentFilters.guests && Number(currentFilters.guests) > 1) chipFields.push({ key: 'guests', label: t('filter.travelers', 'Travelers'), value: currentFilters.guests });
  if (currentFilters.beds) {
    const bedLabels = { '1': t('filter.bedSingle', 'Single'), '2': t('filter.bedDouble', 'Double'), '3': t('filter.bedTriple', 'Triple'), '4': t('filter.bedQuadruple', 'Quadruple') };
    chipFields.push({ key: 'beds', label: t('filter.beds', 'Bed type'), value: bedLabels[currentFilters.beds] || currentFilters.beds });
  }
  if (currentFilters.tripType && !lockTripType) chipFields.push({ key: 'tripType', label: t('filter.tripType', 'Trip type'), value: currentFilters.tripType === 'umrah' ? t('filter.umrah', 'Umrah') : t('filter.leisure', 'Leisure') });
  if (currentFilters.priceFrom || currentFilters.priceTo) {
    const from = currentFilters.priceFrom ? Number(currentFilters.priceFrom).toLocaleString() : '0';
    const to = currentFilters.priceTo ? Number(currentFilters.priceTo).toLocaleString() : t('filter.any', 'Any');
    chipFields.push({ key: currentFilters.priceFrom ? 'priceFrom' : 'priceTo', label: t('filter.price', 'Price'), value: from + '–' + to + ' EGP' });
  }
  if (currentFilters.duration) {
    const durationLabels = { '3-4': t('filter.durationShort', '3–4 days'), '5-7': t('filter.durationMedium', '5–7 days'), '8+': t('filter.durationLong', '8+ days') };
    chipFields.push({ key: 'duration', label: t('filter.duration', 'Duration'), value: durationLabels[currentFilters.duration] || currentFilters.duration });
  }
  if (currentFilters.q && !currentFilters.destination) chipFields.push({ key: 'q', label: t('filter.search', 'Search'), value: currentFilters.q });
%>
<form
  id="<%= formId %>"
  action="<%= action %>"
  method="get"
  class="filter-form w-full filter-form--<%= variant %> <%= isHero ? 'mt-8 sm:mt-10' : 'pt-6 sm:pt-8' %>"
  data-filter-form
  data-filter-variant="<%= variant %>"
  data-lock-type="<%= lockTripType %>"
  data-offers-only="<%= offersOnly ? '1' : '' %>"
  novalidate
>
  <div class="booking-shell w-full max-w-340 animate-on-load <%= isHero ? 'pb-6' : 'booking-shell--list pb-4' %>" style="--load-delay: 0.15s">
    <div
      class="booking-widget <%= isHero ? 'is-hero' : 'is-list' %>"
      data-suggest
      data-suggest-mode="explorer"
    >
      <div class="booking-card">
        <div class="booking-bar">
        <label class="booking-seg booking-seg-where">
          <span class="booking-seg-label"><%= t('filter.where', 'Where') %></span>
          <span class="booking-seg-row">
            <svg class="booking-seg-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" stroke="currentColor" stroke-width="1.7"/>
              <circle cx="12" cy="10" r="2.2" fill="currentColor"/>
            </svg>
            <input
              type="text"
              name="q"
              value="<%= currentFilters.q || currentFilters.destination || '' %>"
              placeholder="<%= lockTripType === 'umrah' ? t('umrah.wherePlaceholder', 'Makkah, Madinah, or package') : t('filter.wherePlaceholder', 'City, destination, or trip') %>"
              autocomplete="off"
              data-filter-field
              data-suggest-input
              aria-autocomplete="list"
              aria-expanded="false"
            />
          </span>
          <input type="hidden" name="destination" value="<%= currentFilters.destination || '' %>" data-filter-field data-dest-hidden />
        </label>

        <div class="booking-seg booking-seg-when" data-date-picker data-date-panel-id="date-panel-<%= variant %>">
          <span class="booking-seg-label"><%= t('filter.when', 'When') %></span>
          <button
            type="button"
            class="booking-seg-row booking-date-trigger-wrap"
            data-date-trigger
            aria-expanded="false"
            aria-haspopup="dialog"
            aria-controls="date-panel-<%= variant %>"
          >
            <svg class="booking-seg-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3.4" y="5.2" width="17.2" height="15.4" rx="2.4" stroke="currentColor" stroke-width="1.7"/>
              <path d="M8 3.5v3.4M16 3.5v3.4M3.4 10h17.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
            <span class="booking-date-display is-placeholder" data-date-display><%= t('filter.selectDate', 'Select date') %></span>
          </button>
          <input type="hidden" name="date" value="<%= currentFilters.date || '' %>" data-filter-field data-date-input />

          <div
            id="date-panel-<%= variant %>"
            class="booking-date-panel"
            data-date-panel
            role="dialog"
            aria-hidden="true"
            aria-label="<%= t('filter.selectDate', 'Select date') %>"
          >
            <div class="booking-date-panel-inner">
              <div class="booking-date-header">
                <button type="button" class="booking-date-nav" data-date-prev aria-label="<%= t('filter.prevMonth', 'Previous month') %>">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <p class="booking-date-month" data-date-month-label></p>
                <button type="button" class="booking-date-nav" data-date-next aria-label="<%= t('filter.nextMonth', 'Next month') %>">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
              <div class="booking-date-weekdays" data-date-weekdays aria-hidden="true"></div>
              <div class="booking-date-grid" data-date-grid role="grid"></div>
              <div class="booking-date-footer">
                <button type="button" class="booking-date-action" data-date-clear><%= t('filter.calendarClear', 'Clear') %></button>
                <button type="button" class="booking-date-action booking-date-action--primary" data-date-today><%= t('filter.today', 'Today') %></button>
              </div>
            </div>
          </div>
        </div>

        <div class="booking-seg booking-seg-who">
          <span class="booking-seg-label"><%= t('filter.travelers', 'Travelers') %></span>
          <div class="filter-stepper booking-stepper" data-stepper-group="guests">
            <button type="button" class="filter-stepper-btn" data-stepper="minus" aria-label="<%= t('filter.decreaseGuests', 'Decrease guests') %>">−</button>
            <input type="number" name="guests" min="1" max="99" value="<%= currentFilters.guests || '1' %>" class="filter-stepper-input" data-filter-field data-stepper-input />
            <button type="button" class="filter-stepper-btn" data-stepper="plus" aria-label="<%= t('filter.increaseGuests', 'Increase guests') %>">+</button>
          </div>
        </div>

        <div class="booking-seg booking-seg-beds">
          <span class="booking-seg-label"><%= t('filter.beds', 'Bed type') %></span>
          <span class="booking-seg-row">
            <svg class="booking-seg-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 20v-8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              <path d="M3 12h18M7 12V8.5A2.5 2.5 0 0 1 9.5 6h5A2.5 2.5 0 0 1 17 8.5V12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
            <select name="beds" class="booking-seg-control" data-filter-field data-beds-select>
              <option value="" <%= !currentFilters.beds ? 'selected' : '' %>><%= t('filter.bedAny', 'Any') %></option>
              <option value="1" <%= currentFilters.beds === '1' ? 'selected' : '' %>><%= t('filter.bedSingle', 'Single') %></option>
              <option value="2" <%= currentFilters.beds === '2' ? 'selected' : '' %>><%= t('filter.bedDouble', 'Double') %></option>
              <option value="3" <%= currentFilters.beds === '3' ? 'selected' : '' %>><%= t('filter.bedTriple', 'Triple') %></option>
              <option value="4" <%= currentFilters.beds === '4' ? 'selected' : '' %>><%= t('filter.bedQuadruple', 'Quadruple') %></option>
            </select>
          </span>
        </div>

        <button
          type="button"
          class="booking-more-btn"
          data-filter-toggle
          aria-expanded="false"
          aria-controls="<%= panelId %>"
        >
          <svg class="filter-toggle-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M19 22V11M19 7V2M12 22V17M12 13V2M5 22V11M5 7V2M3 11H7M17 11H21M10 13H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span><%= t('filter.filter', 'Filter') %></span>
          <span class="filter-badge" data-filter-badge hidden>0</span>
        </button>

        <button type="submit" class="booking-search-btn">
          <%= t('filter.search', 'Search') %>
        </button>
      </div>

      <div id="<%= panelId %>" class="filter-panel booking-more-panel" data-filter-panel role="region" aria-label="<%= t('filter.filter', 'Filter') %>">
        <div class="filter-panel-clip">
          <div class="booking-more-inner">
            <div class="filter-panel-row">
              <% if (lockTripType) { %>
                <input type="hidden" name="tripType" value="<%= lockTripType %>" />
              <% } else { %>
              <div class="filter-field">
                <span class="filter-field-label"><%= t('filter.tripType', 'Trip type') %></span>
                <div class="filter-pills" role="group" aria-label="<%= t('filter.tripType', 'Trip type') %>" data-filter-pills="tripType">
                  <button type="button" class="filter-pill <%= !currentFilters.tripType ? 'is-active' : '' %>" data-pill-value="" aria-pressed="<%= !currentFilters.tripType ? 'true' : 'false' %>"><%= t('filter.all', 'All') %></button>
                  <button type="button" class="filter-pill <%= currentFilters.tripType === 'leisure' ? 'is-active' : '' %>" data-pill-value="leisure" aria-pressed="<%= currentFilters.tripType === 'leisure' ? 'true' : 'false' %>"><%= t('filter.leisure', 'Leisure') %></button>
                  <button type="button" class="filter-pill <%= currentFilters.tripType === 'umrah' ? 'is-active' : '' %>" data-pill-value="umrah" aria-pressed="<%= currentFilters.tripType === 'umrah' ? 'true' : 'false' %>"><%= t('filter.umrah', 'Umrah') %></button>
                </div>
                <input type="hidden" name="tripType" value="<%= currentFilters.tripType || '' %>" data-filter-field />
              </div>
              <% } %>
              <div class="filter-field filter-field-price">
                <span class="filter-field-label"><%= t('filter.price', 'Price') %></span>
                <div class="filter-price-presets" data-price-presets>
                  <button type="button" class="filter-preset <%= !currentFilters.priceFrom && !currentFilters.priceTo ? 'is-active' : '' %>" data-price-min="" data-price-max=""><%= t('filter.priceAny', 'Any') %></button>
                  <button type="button" class="filter-preset <%= !currentFilters.priceFrom && currentFilters.priceTo === '8000' ? 'is-active' : '' %>" data-price-min="" data-price-max="8000"><%= t('filter.priceUnder8k', 'Under 8k') %></button>
                  <button type="button" class="filter-preset <%= currentFilters.priceFrom === '8000' && currentFilters.priceTo === '12000' ? 'is-active' : '' %>" data-price-min="8000" data-price-max="12000"><%= t('filter.price8to12k', '8–12k') %></button>
                  <button type="button" class="filter-preset <%= currentFilters.priceFrom === '12000' && currentFilters.priceTo === '20000' ? 'is-active' : '' %>" data-price-min="12000" data-price-max="20000"><%= t('filter.price12to20k', '12–20k') %></button>
                  <button type="button" class="filter-preset <%= currentFilters.priceFrom === '20000' && !currentFilters.priceTo ? 'is-active' : '' %>" data-price-min="20000" data-price-max=""><%= t('filter.price20kPlus', '20k+') %></button>
                </div>
                <div class="filter-price-range">
                  <label class="filter-price-box">
                    <span class="filter-price-affix">EGP</span>
                    <input
                      type="text"
                      inputmode="numeric"
                      autocomplete="off"
                      name="priceFrom"
                      value="<%= currentFilters.priceFrom || '' %>"
                      placeholder="<%= t('filter.priceMin', 'Min') %>"
                      class="filter-input"
                      data-filter-field
                      data-price-input="from"
                    />
                  </label>
                  <span class="filter-price-sep">–</span>
                  <label class="filter-price-box">
                    <span class="filter-price-affix">EGP</span>
                    <input
                      type="text"
                      inputmode="numeric"
                      autocomplete="off"
                      name="priceTo"
                      value="<%= currentFilters.priceTo || '' %>"
                      placeholder="<%= t('filter.priceMax', 'Max') %>"
                      class="filter-input"
                      data-filter-field
                      data-price-input="to"
                    />
                  </label>
                </div>
              </div>
              <div class="filter-field">
                <span class="filter-field-label"><%= t('filter.duration', 'Duration') %></span>
                <div class="filter-pills" role="group" aria-label="<%= t('filter.duration', 'Duration') %>" data-filter-pills="duration">
                  <button type="button" class="filter-pill <%= !currentFilters.duration ? 'is-active' : '' %>" data-pill-value="" aria-pressed="<%= !currentFilters.duration ? 'true' : 'false' %>"><%= t('filter.durationAny', 'Any') %></button>
                  <button type="button" class="filter-pill <%= currentFilters.duration === '3-4' ? 'is-active' : '' %>" data-pill-value="3-4" aria-pressed="<%= currentFilters.duration === '3-4' ? 'true' : 'false' %>"><%= t('filter.duration3to4', '3–4') %></button>
                  <button type="button" class="filter-pill <%= currentFilters.duration === '5-7' ? 'is-active' : '' %>" data-pill-value="5-7" aria-pressed="<%= currentFilters.duration === '5-7' ? 'true' : 'false' %>"><%= t('filter.duration5to7', '5–7') %></button>
                  <button type="button" class="filter-pill <%= currentFilters.duration === '8+' ? 'is-active' : '' %>" data-pill-value="8+" aria-pressed="<%= currentFilters.duration === '8+' ? 'true' : 'false' %>"><%= t('filter.duration8plus', '8+') %></button>
                </div>
                <input type="hidden" name="duration" value="<%= currentFilters.duration || '' %>" data-filter-field />
              </div>
              <div class="filter-field filter-field-beds">
                <span class="filter-field-label"><%= t('filter.beds', 'Bed type') %></span>
                <div class="filter-pills" role="group" aria-label="<%= t('filter.beds', 'Bed type') %>" data-filter-pills="beds" data-beds-pills>
                  <button type="button" class="filter-pill <%= !currentFilters.beds ? 'is-active' : '' %>" data-pill-value="" aria-pressed="<%= !currentFilters.beds ? 'true' : 'false' %>"><%= t('filter.all', 'All') %></button>
                  <button type="button" class="filter-pill <%= currentFilters.beds === '1' ? 'is-active' : '' %>" data-pill-value="1" aria-pressed="<%= currentFilters.beds === '1' ? 'true' : 'false' %>"><%= t('filter.bedSingle', 'Single') %></button>
                  <button type="button" class="filter-pill <%= currentFilters.beds === '2' ? 'is-active' : '' %>" data-pill-value="2" aria-pressed="<%= currentFilters.beds === '2' ? 'true' : 'false' %>"><%= t('filter.bedDouble', 'Double') %></button>
                  <button type="button" class="filter-pill <%= currentFilters.beds === '3' ? 'is-active' : '' %>" data-pill-value="3" aria-pressed="<%= currentFilters.beds === '3' ? 'true' : 'false' %>"><%= t('filter.bedTriple', 'Triple') %></button>
                  <button type="button" class="filter-pill <%= currentFilters.beds === '4' ? 'is-active' : '' %>" data-pill-value="4" aria-pressed="<%= currentFilters.beds === '4' ? 'true' : 'false' %>"><%= t('filter.bedQuadruple', 'Quadruple') %></button>
                </div>
              </div>
              <div class="filter-panel-actions">
                <p class="filter-live-hint" data-filter-hint hidden></p>
                <button type="button" class="filter-btn-secondary" data-filter-clear><%= t('filter.clearAll', 'Clear all') %></button>
                <button
                  type="submit"
                  class="filter-btn-primary"
                  data-filter-apply
                  data-apply-label="<%= t('filter.apply', 'Apply filters') %>"
                  data-show-trips="<%= t('filter.showTrips', 'Show %s trips') %>"
                  data-show-trip="<%= t('filter.showTrip', 'Show 1 trip') %>"
                  data-no-trips="<%= t('filter.noMatchingTrips', 'No matching trips') %>"
                ><%= t('filter.apply', 'Apply filters') %></button>
              </div>
            </div>
          </div>
        </div>
      </div>
      </div>

      <div class="booking-explorer" data-suggest-panel aria-hidden="true">
        <div class="booking-explorer-clip">
          <div class="booking-explorer-body" data-suggest-body></div>
        </div>
      </div>
    </div>

    <% if (chipFields.length) { %>
      <div class="filter-chips mt-3 flex flex-wrap items-center gap-2" data-filter-chips>
        <% chipFields.forEach(function(chip) { %>
          <button
            type="button"
            class="filter-chip"
            data-chip-remove="<%= chip.key %>"
            aria-label="<%= t('filter.removeFilter', 'Remove filter') %>: <%= chip.label %>"
          >
            <span class="filter-chip-label"><%= chip.label %>:</span>
            <span class="filter-chip-value"><%= chip.value %></span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        <% }) %>
        <button type="button" class="filter-chip-clear" data-filter-clear-chips>
          <%= t('filter.clearAll', 'Clear all') %>
        </button>
      </div>
    <% } %>
  </div>
</form>
